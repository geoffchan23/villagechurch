---
// Floating theme switcher for gathering feedback on the design.
// Swatches render with the real theme tokens (each one carries its own
// data-theme), so adding a theme is just a new block in global.css plus a line here.
export const themes = [
  { id: 'cabin', name: 'Cabin', note: 'From the logo — warm cream, brown and sage' },
  { id: 'midnight', name: 'Midnight', note: 'Full dark mode, candlelight gold, airy type' },
  { id: 'editorial', name: 'Editorial', note: 'Magazine style — ink, newsprint, one red' },
  { id: 'sunrise', name: 'Sunrise', note: 'Vibrant coral-to-violet, chunky and playful' },
  { id: 'block', name: 'Block', note: 'Bold poster style — outlines and hard shadows' },
  { id: 'meadow', name: 'Meadow', note: 'Soft and light — pale greens, blush, italics' },
];
---

<div class="tp" transition:persist>
  <button class="tp__toggle" type="button" aria-expanded="false" aria-controls="tp-panel">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0 0 18c1 0 1.7-.8 1.7-1.7 0-.4-.2-.8-.4-1.1-.3-.3-.4-.7-.4-1.1 0-.9.8-1.7 1.7-1.7h2A5.4 5.4 0 0 0 21 10c0-3.9-4-7-9-7zm-5.5 9a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm3-4a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm3 4a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"></path></svg>
    <span>Theme</span>
  </button>
  <div class="tp__panel" id="tp-panel" hidden>
    <p class="tp__head">Preview a theme</p>
    <ul class="tp__list">
      {
        themes.map((t) => (
          <li>
            <button type="button" class="tp__opt" data-set-theme={t.id} aria-pressed="false">
              <span class="tp__sw" data-theme={t.id} aria-hidden="true">
                <span style="background:var(--bg)" />
                <span style="background:var(--inverse-bg)" />
                <span style="background:var(--accent)" />
                <span style="background:var(--tint)" />
              </span>
              <span class="tp__txt">
                <span class="tp__name" data-theme={t.id} style="font-style:var(--heading-style)">{t.name}</span>
                <span class="tp__note">{t.note}</span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
    <button type="button" class="tp__copy" data-copy-theme>Copy link to this theme</button>
  </div>
</div>

<style>
  .tp {
    position: fixed;
    left: 1rem;
    bottom: calc(var(--player-h) + 1rem);
    z-index: 60;
    font-family: system-ui, -apple-system, sans-serif;
    transition: bottom 0.25s ease;
  }
  .tp__toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.95rem 0.55rem 0.75rem;
    border: 1px solid rgb(0 0 0 / 0.12);
    border-radius: 999px;
    background: #fff;
    color: #222;
    font: 600 0.85rem system-ui, sans-serif;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.15);
    cursor: pointer;
  }
  .tp__toggle svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  .tp__panel {
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.6rem);
    width: min(20rem, calc(100vw - 2rem));
    background: #fff;
    color: #222;
    border-radius: 14px;
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.22);
    padding: 0.75rem;
  }
  .tp__panel[hidden] {
    display: none;
  }
  .tp__head {
    font: 600 0.72rem system-ui, sans-serif;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #777;
    margin: 0.25rem 0.4rem 0.6rem;
  }
  .tp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .tp__opt {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.55rem;
    border: 2px solid transparent;
    border-radius: 10px;
    background: none;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .tp__opt:hover {
    background: #f3f3f3;
  }
  .tp__opt[aria-pressed='true'] {
    border-color: #222;
  }
  .tp__sw {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    overflow: hidden;
    flex: none;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.1);
  }
  .tp__txt {
    display: grid;
  }
  .tp__name {
    font-family: var(--font-heading);
    font-weight: var(--heading-weight);
    font-variation-settings: var(--heading-settings);
    font-size: 1.05rem;
    color: #222;
  }
  .tp__note {
    font-size: 0.78rem;
    color: #666;
    line-height: 1.3;
  }
  .tp__copy {
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.6rem;
    border: 0;
    border-radius: 8px;
    background: #222;
    color: #fff;
    font: 600 0.85rem system-ui, sans-serif;
    cursor: pointer;
  }
  @media print {
    .tp {
      display: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.tp')!;
  const toggle = root.querySelector<HTMLButtonElement>('.tp__toggle')!;
  const panel = root.querySelector<HTMLElement>('.tp__panel')!;
  const copy = root.querySelector<HTMLButtonElement>('[data-copy-theme]')!;

  const current = () => document.documentElement.dataset.theme || 'cabin';

  function mark() {
    root.querySelectorAll<HTMLElement>('[data-set-theme]').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.setTheme === current())),
    );
  }

  function setTheme(id: string) {
    document.documentElement.dataset.theme = id;
    try {
      localStorage.setItem('vc:theme', id);
    } catch {}
    const url = new URL(location.href);
    url.searchParams.set('theme', id);
    history.replaceState(history.state, '', url);
    mark();
  }

  function open(on: boolean) {
    panel.hidden = !on;
    toggle.setAttribute('aria-expanded', String(on));
  }

  toggle.addEventListener('click', () => open(panel.hidden));
  root.addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-set-theme]')?.dataset.setTheme;
    if (id) setTheme(id);
  });
  document.addEventListener('click', (e) => !root.contains(e.target as Node) && open(false));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && open(false));

  copy.addEventListener('click', async () => {
    const url = new URL(location.href);
    url.searchParams.set('theme', current());
    url.searchParams.delete('t');
    await navigator.clipboard.writeText(url.href);
    copy.textContent = 'Link copied!';
    setTimeout(() => (copy.textContent = 'Copy link to this theme'), 1800);
  });

  document.addEventListener('astro:page-load', mark);
</script>
