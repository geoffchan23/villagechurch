---
import { u } from '../lib/url';
// Fonts for every theme. Browsers only download the ones a theme actually uses.
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/lora';
import '@fontsource-variable/outfit';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/dm-serif-display';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Image } from 'astro:assets';
import Player from '../components/Player.astro';
import ThemePicker from '../components/ThemePicker.astro';
import logo from '../assets/logo.png';
import { church, nav, sunday, showThemePicker } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = church.welcome, image } = Astro.props;
const fullTitle = title ? `${title} · ${church.name}` : `${church.name} · Sundays ${sunday.time}`;
const path = Astro.url.pathname;
// Preview builds (served under a sub-path) stay out of search results.
const isPreview = import.meta.env.BASE_URL !== '/';
const canonical = new URL(path, Astro.site);
const ogImage = new URL(image ?? u('/podcast-cover.png'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('/favicon.png')} />
    <link rel="apple-touch-icon" href={u('/favicon.png')} />
    <link rel="alternate" type="application/rss+xml" title="Village Church Newcastle Sermons" href={u('/podcast.xml')} />
    <meta name="theme-color" content="#4a2e22" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={church.name} />
    <meta property="og:title" content={title ?? church.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <slot name="head" />
    {isPreview && <meta name="robots" content="noindex" />}
    <script is:inline>
      // Apply the chosen theme before first paint (and again after each page swap).
      (function () {
        function apply() {
          var t = new URLSearchParams(location.search).get('theme');
          try {
            if (t) localStorage.setItem('vc:theme', t);
            else t = localStorage.getItem('vc:theme');
          } catch (e) {}
          if (t) document.documentElement.dataset.theme = t;
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a href={u('/')} class="brand" aria-label={`${church.name} home`}>
          <Image src={logo} alt="" width={52} height={52} class="brand__logo" loading="eager" />
          <span class="brand__name">Village Church <small>Newcastle</small></span>
        </a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
        <label for="nav-toggle" class="nav-burger" aria-label="Menu"><span></span></label>
        <nav class="site-nav" aria-label="Main">
          {
            nav.map((n) => (
              <a href={u(n.href)} aria-current={path.startsWith(u(n.href)) ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
          <a href={u('/#visit')} class="btn btn--ghost site-nav__cta">Plan a visit</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__grid">
        <div>
          <p class="site-footer__name">{church.name}</p>
          <p>{church.tagline.join(' · ')}</p>
        </div>
        <div>
          <p class="site-footer__label">Sundays {sunday.time}</p>
          <p>
            {church.address.venue}<br />
            <a href={church.address.mapUrl}>{church.address.street}, {church.address.city}</a>
          </p>
        </div>
        <div>
          <p class="site-footer__label">Get in touch</p>
          <p>
            <a href={`mailto:${church.email}`}>{church.email}</a><br />
            <a href={church.phoneHref}>{church.phone}</a>
          </p>
        </div>
        <div>
          <p class="site-footer__label">Follow</p>
          <p>
            <a href={church.social.facebook}>Facebook</a><br />
            {church.social.instagram && (<><a href={church.social.instagram}>Instagram</a><br /></>)}
            <a href={u('/podcast.xml')}>Sermon podcast (RSS)</a>
          </p>
        </div>
      </div>
      <div class="wrap site-footer__base">© {new Date().getFullYear()} {church.name}</div>
    </footer>

    <Player />
    {showThemePicker && <ThemePicker />}

    <script>
      // Close the mobile menu after navigating.
      document.addEventListener('astro:after-swap', () => {
        const t = document.getElementById('nav-toggle') as HTMLInputElement | null;
        if (t) t.checked = false;
      });
    </script>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed !important;
    top: 0.5rem;
    left: 0.5rem;
    width: auto;
    height: auto;
    clip: auto;
    z-index: 100;
    background: var(--surface);
    padding: 0.5rem 1rem;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--light) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--dark);
  }
  .brand__logo {
    width: 52px;
    height: 52px;
    border-radius: 10px;
  }
  .brand__name {
    font: var(--heading-weight) 1.2rem/1.05 var(--font-heading);
    display: grid;
  }
  .brand__name small {
    font: 600 0.68rem/1.4 var(--font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 2rem);
  }
  .site-nav a:not(.btn) {
    color: var(--dark);
    text-decoration: none;
    font-weight: 500;
    padding-block: 0.4rem;
    border-bottom: 2px solid transparent;
  }
  .site-nav a:not(.btn):hover,
  .site-nav a[aria-current='page'] {
    border-bottom-color: var(--accent);
  }
  .site-nav__cta {
    padding: 0.55rem 1.1rem;
  }
  .nav-burger {
    display: none;
  }

  @media (max-width: 760px) {
    .nav-burger {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      cursor: pointer;
    }
    .nav-burger span,
    .nav-burger span::before,
    .nav-burger span::after {
      display: block;
      width: 22px;
      height: 2px;
      background: var(--dark);
      position: relative;
      content: '';
      transition: transform 0.2s;
    }
    .nav-burger span::before {
      position: absolute;
      top: -7px;
    }
    .nav-burger span::after {
      position: absolute;
      top: 7px;
    }
    .nav-toggle:checked + .nav-burger span {
      background: transparent;
    }
    .nav-toggle:checked + .nav-burger span::before {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle:checked + .nav-burger span::after {
      transform: translateY(-7px) rotate(-45deg);
    }
    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem var(--gutter) 1.25rem;
      background: var(--light);
      border-bottom: 1px solid var(--line);
    }
    .site-nav a:not(.btn) {
      padding: 0.85rem 0;
      border-bottom: 1px solid var(--line);
      font-size: 1.1rem;
    }
    .site-nav__cta {
      margin-top: 1rem;
      justify-content: center;
    }
    .nav-toggle:checked ~ .site-nav {
      display: flex;
    }
  }

  .site-footer {
    background: var(--dark);
    color: color-mix(in srgb, var(--light) 85%, transparent);
    padding-block: 3.5rem 1.5rem;
    font-size: 0.95rem;
  }
  .site-footer a {
    color: var(--light);
  }
  .site-footer__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
  }
  .site-footer__name {
    font: var(--heading-weight) 1.35rem var(--font-heading);
    color: var(--light);
    margin-bottom: 0.3rem;
  }
  .site-footer__label {
    font: 600 0.75rem var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .site-footer__base {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, #fff 12%, transparent);
    font-size: 0.85rem;
    opacity: 0.7;
  }
</style>
