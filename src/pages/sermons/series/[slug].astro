---
import { u } from '../../../lib/url';
import Base from '../../../layouts/Base.astro';
import SermonRow from '../../../components/SermonRow.astro';
import { seriesList, prettyDate, sermonHref } from '../../../lib/sermons';
import { abs } from '../../../lib/schema';

export function getStaticPaths() {
  return seriesList().map((s) => ({ params: { slug: s.slug }, props: { series: s } }));
}
const { series } = Astro.props as { series: ReturnType<typeof seriesList>[number] };
const speakers = [...new Set(series.items.map((s) => s.speaker).filter(Boolean))];
const range = series.first === series.latest ? prettyDate(series.latest) : `${prettyDate(series.first, 'short')} – ${prettyDate(series.latest, 'short')}`;
// Oldest first reads more naturally within a series.
const items = [...series.items].reverse();
---

<Base
  title={`${series.name} sermon series`}
  description={`${series.items.length} ${series.items.length === 1 ? 'sermon' : 'sermons'} from the ${series.name} series at Village Church Newcastle${speakers.length ? `, with ${speakers.join(', ')}` : ''} (${range}).`}
  breadcrumbs={[{ name: 'Sermons', path: '/sermons/' }, { name: series.name, path: `/sermons/series/${series.slug}/` }]}
  schema={[{
    '@type': 'CreativeWorkSeries',
    name: `${series.name} sermon series`,
    url: abs(`/sermons/series/${series.slug}/`, Astro.site!),
    publisher: { '@id': abs('/#church', Astro.site!) },
    hasPart: items.map((s) => ({ '@type': 'PodcastEpisode', name: s.title, url: abs(sermonHref(s), Astro.site!), datePublished: s.date })),
  }]}
>
  <section class="page-head">
    <div class="wrap">
      <a href={u('/sermons/')} class="back">← All sermons</a>
      <span class="eyebrow">Series</span>
      <h1>{series.name}</h1>
      <p class="lede">{series.items.length} {series.items.length === 1 ? 'message' : 'messages'} · {range}</p>
      {speakers.length > 0 && <p class="speakers">With {speakers.join(', ')}</p>}
    </div>
  </section>
  <section class="wrap" style="padding-bottom: 5rem">
    <ol class="list">
      {items.map((s) => <SermonRow sermon={s} />)}
    </ol>
  </section>
</Base>

<style>
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.92rem;
  }
  .speakers {
    color: var(--muted);
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
