---
import { u } from '../../lib/url';
import { abs, isoDuration } from '../../lib/schema';
import Base from '../../layouts/Base.astro';
import PlayButton from '../../components/PlayButton.astro';
import SermonRow from '../../components/SermonRow.astro';
import { sermons, sermonHref, prettyDate, minutes, playPayload, slug as slugify, type Sermon } from '../../lib/sermons';

export function getStaticPaths() {
  return sermons.map((s, i) => ({
    params: { slug: s.slug },
    props: { sermon: s, newer: sermons[i - 1] ?? null, older: sermons[i + 1] ?? null },
  }));
}

interface Props {
  sermon: Sermon;
  newer: Sermon | null;
  older: Sermon | null;
}
const { sermon: s, newer, older } = Astro.props;
const related = s.series ? sermons.filter((x) => x.series === s.series && x.id !== s.id).slice(0, 5) : [];
const bibleLink = (p: string) => `https://www.biblegateway.com/passage/?search=${encodeURIComponent(p)}&version=NIV`;
const summary = [s.speaker, prettyDate(s.date), s.series && `${s.series} series`, s.passages.join('; ')].filter(Boolean).join(' · ');
const description = `“${s.title}” — a sermon${s.speaker ? ` by ${s.speaker}` : ''} at Village Church Newcastle${s.passages.length ? ` on ${s.passages.join('; ')}` : ''}${s.series ? `, part of the ${s.series} series` : ''}. Preached ${prettyDate(s.date)}. Listen or watch online.`;
const site = Astro.site!;
const pageUrl = abs(sermonHref(s), site);
const episode = {
  '@type': 'PodcastEpisode',
  '@id': `${pageUrl}#episode`,
  name: s.title,
  url: pageUrl,
  description,
  datePublished: s.date,
  inLanguage: 'en',
  ...(s.audio && { timeRequired: isoDuration(s.audio.duration) }),
  author: s.speaker ? { '@type': 'Person', name: s.speaker } : { '@id': abs('/#church', site) },
  publisher: { '@id': abs('/#church', site) },
  partOfSeries: { '@type': 'PodcastSeries', name: 'Village Church Newcastle Sermons', url: abs('/sermons/', site), webFeed: abs('/podcast.xml', site) },
  ...(s.passages.length && { about: s.passages.map((p) => ({ '@type': 'CreativeWork', name: p, genre: 'Bible passage' })) }),
  ...(s.topics.length && { keywords: s.topics.join(', ') }),
  ...(s.audio && {
    associatedMedia: { '@type': 'AudioObject', contentUrl: s.audio.url, encodingFormat: 'audio/mpeg', duration: isoDuration(s.audio.duration) },
  }),
  ...(s.video && {
    video: {
      '@type': 'VideoObject',
      name: s.title,
      description,
      uploadDate: s.date,
      contentUrl: s.video.url,
      ...(s.video.poster && { thumbnailUrl: s.video.poster }),
      ...(s.audio && { duration: isoDuration(s.audio.duration) }),
    },
  }),
};
---

<Base
  title={s.title}
  description={description}
  image={s.video?.poster ?? undefined}
  ogType="article"
  markdown={`/sermons/${s.slug}.md`}
  breadcrumbs={[
    { name: 'Sermons', path: '/sermons/' },
    ...(s.series ? [{ name: s.series, path: `/sermons/series/${slugify(s.series)}/` }] : []),
    { name: s.title, path: sermonHref(s) },
  ]}
  schema={[episode]}
>

  <article class="wrap sermon" data-autoload data-play={playPayload(s)}>
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={u('/sermons/')}>Sermons</a>
      {s.series && (<> <span aria-hidden="true">/</span> <a href={u(`/sermons/series/${slugify(s.series)}/`)}>{s.series}</a></>)}
    </nav>

    <header class="sermon__head">
      <p class="eyebrow">{prettyDate(s.date)}</p>
      <h1>{s.title}</h1>
      <p class="sermon__summary">{description.replace(' Listen or watch online.', '')}</p>
      <p class="sermon__meta">
        {s.speaker && <span>{s.speaker}</span>}
        {s.audio && <span>{minutes(s.audio.duration)}</span>}
      </p>
      <div class="sermon__actions">
        <PlayButton sermon={s} size="lg" label="Listen" />
        {s.video && <a href="#watch" class="btn btn--ghost">Watch video</a>}
        {s.audio && <a href={s.audio.url} class="btn btn--ghost" download>Download MP3</a>}
        <span class="sermon__resume" data-resume-for={s.id} hidden></span>
      </div>
    </header>

    <div class="sermon__body">
      <div class="sermon__main">
        {
          s.video && (
            <section id="watch" class="sermon__video">
              <h2 class="visually-hidden">Video</h2>
              <video
                controls
                playsinline
                preload="none"
                poster={s.video.poster ?? undefined}
                width={s.video.width ?? undefined}
                height={s.video.height ?? undefined}
              >
                <source src={s.video.url} type="video/mp4" />
              </video>
            </section>
          )
        }

        {
          related.length > 0 && (
            <section class="sermon__related">
              <h2>More from {s.series}</h2>
              <ul>
                {related.map((r) => (
                  <SermonRow sermon={r} />
                ))}
              </ul>
              <a href={u(`/sermons/series/${slugify(s.series!)}/`)}>See the whole series →</a>
            </section>
          )
        }
      </div>

      <aside class="sermon__aside">
        {
          s.passages.length > 0 && (
            <div class="card">
              <h3>Scripture</h3>
              <ul class="passages">
                {s.passages.map((p) => (
                  <li>
                    <a href={bibleLink(p)}>{p}</a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          s.topics.length > 0 && (
            <div class="card">
              <h3>Topics</h3>
              <ul class="topics">
                {s.topics.map((t) => (
                  <li>
                    <a href={u(`/sermons/?q=${encodeURIComponent(t)}`)}>{t}</a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="card">
          <h3>Never miss one</h3>
          <p>Get new sermons in your podcast app.</p>
          <a href={u('/podcast.xml')}>Podcast feed (RSS)</a>
        </div>
      </aside>
    </div>

    <nav class="pager" aria-label="More sermons">
      {older ? <a href={sermonHref(older)} class="pager__prev"><small>← Previous</small>{older.title}</a> : <span />}
      {newer && <a href={sermonHref(newer)} class="pager__next"><small>Next →</small>{newer.title}</a>}
    </nav>
  </article>
</Base>

<style>
  .sermon {
    padding-block: 2rem 5rem;
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .sermon__head {
    padding-block: clamp(2rem, 5vw, 3.5rem) 2rem;
    border-bottom: var(--border-w) solid var(--line);
  }
  .sermon__head h1 {
    max-width: 22ch;
  }
  .sermon__summary {
    max-width: 44rem;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .sermon__meta {
    display: flex;
    gap: 1.2rem;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .sermon__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .sermon__resume {
    color: var(--highlight);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .sermon__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-top: 2.5rem;
  }
  @media (max-width: 860px) {
    .sermon__body {
      grid-template-columns: 1fr;
    }
  }
  .sermon__video video {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    background: #000;
    box-shadow: var(--shadow);
    scroll-margin-top: 6rem;
  }
  .sermon__related {
    margin-top: 3rem;
  }
  .sermon__related ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }
  .sermon__aside {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .sermon__aside h3 {
    font-size: 1.05rem;
  }
  .sermon__aside p {
    font-size: 0.95rem;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .passages,
  .topics {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .passages {
    display: grid;
  }
  .topics a {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: var(--tint);
    text-decoration: none;
    font-size: 0.88rem;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: var(--border-w) solid var(--line);
  }
  .pager a {
    display: grid;
    max-width: 45%;
    font: var(--heading-weight) 1.05rem/1.3 var(--font-heading);
    color: var(--heading);
    text-decoration: none;
  }
  .pager small {
    font: 500 0.82rem var(--font-body);
    color: var(--muted);
  }
  .pager__next {
    text-align: right;
    margin-left: auto;
  }
</style>
