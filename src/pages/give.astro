---
import Base from '../layouts/Base.astro';
import { church, giving, partners } from '../data/site';
---

<Base title="Give" description="Support the life and mission of Village Church Newcastle.">
  <section class="page-head">
    <div class="narrow">
      <span class="eyebrow">Give</span>
      <h1>Generosity is part of following Jesus</h1>
      <p class="lede">
        We see our time, energy and resources as sacred responsibilities entrusted to us by Jesus. Thank you for partnering with us.
      </p>
    </div>
  </section>
  <section class="section section--paper">
    <div class="narrow">
      <div class="card give">
        <h2>Give online</h2>
        <p>{giving}</p>
        <ol>
          <li>Visit the {partners.network.name} donation page.</li>
          <li>Note that your gift is for <strong>Village Church Newcastle</strong>.</li>
          <li>You’ll receive a tax receipt from {partners.network.name} at tax time.</li>
        </ol>
        <a class="btn" href={church.giveUrl}>Give through Vision Ministries Canada →</a>
      </div>
      <p class="q">Questions about giving? <a href={`mailto:${church.email}?subject=Giving`}>{church.email}</a></p>
    </div>
  </section>
</Base>

<style>
  .give {
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .give ol {
    margin: 1.25rem 0 1.75rem;
    padding-left: 1.2rem;
  }
  .give li {
    margin-bottom: 0.4rem;
  }
  .q {
    margin-top: 1.5rem;
    color: var(--muted);
  }
</style>
